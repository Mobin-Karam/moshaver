# Set these in the Runflare service Environment Variables panel. Do not commit real secrets.
NODE_ENV=production
PORT=4000
DATABASE_PATH=/data/moshaver.sqlite
CORS_ORIGINS=https://st.mahakaram.ir,https://admin.mahakaram.ir
TRUST_PROXY=1
COOKIE_SECURE=1
COOKIE_SAMESITE=Strict
ALLOW_BEARER_AUTH=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
STUDENT_USERNAME=student
STUDENT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

