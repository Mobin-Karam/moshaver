NODE_ENV=production
PORT=4000
# New deployments use this path. On an existing service, retain its current
# DATABASE_PATH instead so the already-mounted database is reused.
DATABASE_PATH=/data/moshaver.sqlite
CORS_ORIGINS=https://st.mahakaram.ir,https://admin.mahakaram.ir,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
SESSION_DAYS_STUDENT=30
SESSION_HOURS_ADMIN=12
SESSION_COOKIE_NAME=moshaver_session
COOKIE_SECURE=1
# Production uses Strict. Local Admin should use admin-app/run-local-admin.sh,
# which reverse-proxies the API and avoids third-party-cookie requirements.
COOKIE_SAMESITE=Strict
ALLOW_BEARER_AUTH=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_DISPLAY_NAME=مشاور
STUDENT_USERNAME=student
STUDENT_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
STUDENT_DISPLAY_NAME=دانش‌آموز
TRUST_PROXY=1
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=15
EVENT_RETENTION_HOURS=72
