{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moshaver Student",
  "version": "0.1.0",
  "identifier": "ir.moshaver.student",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moshaver Student",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
