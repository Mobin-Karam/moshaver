{
  "name": "moshaver-backend-v2",
  "version": "2.0.0",
  "private": true,
  "description": "NestJS + Fastify + TypeORM backend foundation for Moshaver v2",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "migrate:v1": "node scripts/migrate-v1-to-v2.mjs",
    "seed": "npm run build && node dist/database/seeds/seed.js",
    "seed:e2e": "npm run build && node dist/database/seeds/security-matrix.js"
    ,"test:e2e:security": "node scripts/security-matrix-e2e.mjs",
    "test:e2e:student": "node scripts/student-journey-e2e.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0 <23"
  }
}
